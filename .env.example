OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_REASONING_EFFORT=none

# Optional account sync; these two values are PUBLIC client configuration.
# Never put a Supabase secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring Supabase Auth registration and SMTP.
NEXT_PUBLIC_SYNC_SIGNUP=0
# Enable only after SMTP and the recovery OTP email template have been verified.
NEXT_PUBLIC_SYNC_EMAIL_RECOVERY=0
