{
  "name": "englishpilot",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build && node scripts/prepare-pwa.mjs",
    "native:build": "node scripts/build-native.mjs && node scripts/sync-native.mjs",
    "native:sync": "node scripts/sync-native.mjs",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:ios:open": "cap open ios",
    "native:ios:check": "node scripts/native-doctor.mjs --ios-build",
    "native:harmony:build": "node scripts/native-doctor.mjs --harmony-build",
    "package:native": "node scripts/package-native.mjs",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "npm --prefix backend test",
    "build:backend": "npm --prefix backend run build",
    "test:release": "node --test tests-release/*.test.mjs",
    "licenses:collect": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@upstash/redis": "1.39.0",
    "dexie": "^4.2.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "ts-fsrs": "5.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chenwl-sustech/EnglishPilot.git"
  },
  "engines": {
    "node": ">=22"
  }
}
